rotate_logs() {
rotate_logs(){
rotate_logs(){ dir="$1"; max="$2"; find "$dir" -type f -name '*.log' -mtime +7 -exec gzip {} \;; find "$dir" -type f -name '*.log.gz' | sort -r | tail -n +$((max+1)) | xargs -r rm -f; }
rotate_logs(){\n dir=$1; max=$2;\n ls -1t "$dir"/*.log 2>/dev/null | tail -n +$((max+1)) | while read old; do\n rm -f "$old" && echo "Deleted $old";\n done\n}\n# Example: rotate_logs /var/log/myapp 7
