watch_and_compress(){ local dir="$1"; inotifywait -m -e close_write --format "%w%f" "$dir" | while read -r file; do cp --preserve=timestamps "$file" "$file.bak" && gzip -c "$file" > "$file.gz" && rm "$file"; echo "Compressed $file"; done; }; # Usage: watch_and_compress /var/spool
