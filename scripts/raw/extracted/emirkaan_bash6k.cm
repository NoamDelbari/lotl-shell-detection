dir_stats(){ local dir="$1"; local count=$(find "$dir" -type f | wc -l); local size=$(du -sb "$dir" | cut -f1); local avg=$((size/count)); echo "Files: $count"; echo "Total size: $(echo "scale=2;$size/1024/1024" | bc) MB"; echo "Average size: $(echo "scale=2;$avg/1024" | bc) KB"; }
dir_tree() {
dir_tree(){ local dir="$1"; find "$dir" -mindepth 1 -maxdepth 2 -type d | while read sub; do count=$(find "$sub" -type f | wc -l); size=$(du -sh "$sub" | cut -f1); echo "{\"path\": \"${sub}\", \"files\": $count, \"size\": \"$size\"}"; done | jq -s '.'; }
disk_monitor() { while true; do disk_usage=$(df -h | awk '{print $5}' | grep -vE '^$'); if [ $disk_usage -gt 90 ]; then echo 'Disk usage exceeded 90%' | mail -s 'Disk usage alert' admin@example.com; fi; sleep 600; done }; disk_monitor
