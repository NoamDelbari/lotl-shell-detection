while :; do
while :; do count=$(lsof -c postgres | wc -l); echo "$(date +%F%T) $count" >> /var/log/postgres_fds.log; if (( count>1024 )); then logger -p user.warn "postgres open fds > 1024: $count"; fi; sleep 5; done &
while :; do cpu=$(awk '/^cpu /{print 100-($5*100/$2)}' /proc/stat); if (( $(echo "$cpu > 80" | bc -l) )); then echo "$(date +"%Y-%m-%d %H:%M:%S") CPU $cpu%" >> /var/log/high_cpu.log; fi; sleep 5; done
while :; do date '+%Y-%m-%d %H:%M:%S' >> /tmp/java_cpu.log; ps -eo pid,comm,%cpu,args | grep '[j]ava' | sort -k3 -nr | head -5 >> /tmp/java_cpu.log; sleep 2; done &
while :; do free=$(df / --output=avail -B1 | tail -1); total=$(df / --output=size -B1 | tail -1); perc=$(( 100*free/total )); if [ $perc -lt 10 ]; then notify-send "Low Disk Space" "Only $perc% free on /"; fi; sleep 300; done
while :; do free_mb=$(free -m | awk '/Mem:/ {print $4}'); echo "$(date +%F_%T) $free_mb MB" >> /var/log/mem.log; if (( free_mb < 200 )); then echo "Low memory: $free_mb MB" | mail -s "Memory Alert" admin@example.com; fi; sleep 10; done &
while :; do load=$(awk '{print $1}' /proc/loadavg); ts=$(date '+%Y-%m-%d %H:%M:%S'); echo "$ts Load:$load" >> /var/log/cpu_monitor.log; (( $(echo "$load > 4.0" | bc -l) )) && echo "High load $load at $ts" | mail -s "CPU Alert" admin@example.com; sleep 5; done
while :; do temp=$(< /sys/class/thermal/thermal_zone0/temp); temp_c=$((temp/1000)); if [ $temp_c -gt 80 ]; then logger -p user.warn "CPU temperature high: ${temp_c}C"; fi; sleep 30; done &
while :; do temp=$(cat /sys/class/thermal/thermal_zone0/temp); ((c=temp/1000)); if (( c > 80 )); then notify-send "CPU Overheat" "Temp: ${c}°C"; echo "$(date): CPU temp $c°C" >> /var/log/cpu_temp.log; fi; sleep 30; done
while IFS= read -r line; do curl -s -o "$(basename "$line")" "$line"; done < urls.txt
while IFS= read -r url; do code=$(curl -o /dev/null -s -w "%{http_code}" --max-time 5 "$url"); echo "$url,$code"; done < urls.txt > results.csv
while IFS= read -r url; do code=$(curl -o /dev/null -s -w \"%{http_code}\" --max-time 3 "$url"); if [[ $code =~ ^2 ]]; then echo \"$code $url\"; fi; done
while IFS= read -r url; do curl -o /downloads/${url##*/} $url; done < url_list.txt
while IFS=, read -r user email; do sudo useradd -m "$user" && pass=$(openssl rand -base64 12) && echo "$user:$pass" | sudo chpasswd && echo -e "Your account: $user\nPassword: $pass" | mailx -s "Your new account" "$email"; done < users.csv
while IFS=, read -r username uid gid home shell; do
while IFS=: read -r user _ _ _ _ home _; do
while IFS=: read -r user _ _ _ _ homedir _; do [ -d "$homedir" ] || continue; size=$(du -s "$homedir" | awk '{print $1}'); if [ $size -gt $((1024*1024)) ]; then echo -e "$user\t$(echo "scale=2;$size/1024/1024" | bc)GB"; fi; done < /etc/passwd | sort -k2 -hr
while IFS=: read -r user _ uid _ _ _ _; do
while IFS=: read -r user _ uid _ _ _ _; do [ $uid -ge 1000 ] && lastlog -u "$user" | awk 'NR==2{print $4}' | grep -q '^Never$\|$(date -d "90 days ago" +%b)'; if [ $? -eq 0 ]; then usermod -L "$user" && echo "$user"; fi; done < /etc/passwd
while IFS=: read -r user _ uid gid _ home _; do if [ ! -d "$home" ]; then mkdir -p "$home" && cp /etc/skel/.bashrc "$home/" && chown "$uid:$gid" "$home" -R; fi; done < <(cut -d: -f1,3,4,6 /etc/passwd)
while IFS=: read -r username _ uid _ _ homedir _; do if (( uid >= 1000 )); then tar -czf /backups/users/${username}.tar.gz -C "$homedir" .; fi; done < <(cut -d: -f1,3,6 /etc/passwd)
while inotifywait -e create --format "%w%f" /var/www/html | grep -E '\.php$'; do file=$(inotifywait -e create --format "%w%f" /var/www/html); php -l "$file" && echo "$(date +"%Y-%m-%d %H:%M:%S") Lint OK: $file" >> /var/log/php_lint.log || echo "$(date +"%Y-%m-%d %H:%M:%S") Lint FAIL: $file" >> /var/log/php_lint.log; done
while read -r url; do sha=$(curl -sSf --retry 3 --max-time 10 "$url" | sha256sum | awk '{print $1}') && echo "$url $sha" >> checksums.txt; done < urls.txt
while read d; do exp=$(echo | openssl s_client -connect "$d:443" -servername "$d" 2>/dev/null | openssl x509 -noout -dates | grep notAfter | cut -d= -f2); exp_secs=$(date -d "$exp" +%s); now_secs=$(date +%s); days=$(( (exp_secs - now_secs) / 86400 )); echo -e "$d\t$days"; done < domains.txt | sort -k2 -n
while read db; do ts=$(date +%Y%m%d%H%M%S); if mysqldump "$db" | gzip > /backups/mysql/${db}_$ts.sql.gz; then echo "$(date '+%F %T') $db backup succeeded" >> /var/log/mysql_backup.log; else echo "$(date '+%F %T') $db backup FAILED" >> /var/log/mysql_backup.log; fi; done < db_list.txt
while read host; do
while read host; do fail=0; for i in {1..3}; do if ping -c1 -W1 $host > /dev/null; then echo "$(date '+%F %T') $host reachable" >> ping.log; fail=0; break; else fail=$((fail+1)); fi; done; if [ $fail -ge 3 ]; then curl -X POST -d "{\"host\":\"$host\",\"status\":\"down\"}" https://hooks.example.com/alert; fi; done < hosts.txt
while read load _; do echo $load | awk -F' ' '{if($1>4.0){print "High load: "$1 | "mailx -s \"Load Alert\" admin@example.com"}}' ; sleep 30; done < /proc/loadavg &
while read pkg; do dpkg -s "$pkg" &>/dev/null && echo "$pkg already installed" || { apt-get install -y "$pkg" >/dev/null 2>&1 && echo "$pkg installed" || echo "$pkg failed"; } done < packages.txt > install_report.txt
while read url; do fname=$(basename "$url"); expected=$(grep "$fname" checksums.txt | awk '{print $1}'); attempt=0; until [ $attempt -ge 3 ]; do curl -O --progress-bar "$url" && got=$(sha256sum "$fname" | awk '{print $1}') && if [ "$got" = "$expected" ]; then echo "$fname OK"; break; else echo "$fname checksum mismatch"; rm -f "$fname"; fi; attempt=$((attempt+1)); done; done < urls.txt
while sleep 5; do
while sleep 5; do usage=$(mpstat 1 1 | awk '/Average/ {print 100-$NF}'); if (( $(echo "$usage > 80" | bc -l) )); then echo \"$(date +'%Y-%m-%d %H:%M:%S') CPU $usage%\" >> ~/cpu.log; fi; done &
while sleep 60; do load=$(awk '{print $1}' /proc/loadavg); cores=$(nproc); if (( $(echo "$load > $cores+2" | bc -l) )); then echo "$(date +%F\\%T) High load: $load" >> /var/log/load_warn.log; fi; done &
while sleep 60; do total=$(du -sb /var/log | cut -f1); if (( total > 10737418240 )); then oldest=$(find /var/log -type f -printf '%T@ %p\n' | sort -n | head -1 | cut -d' ' -f2-); gzip -9 "$oldest"; find /var/log -type f -mtime +30 -delete; fi; done
while true; do
while true; do FREE_SPACE=$(df -h | awk '//$/ {print $5}'); if [ $FREE_SPACE -lt 10 ]; then echo 'Low disk space'; fi; sleep 60; done
while true; do available_space=$(df -h / | awk '/// {print $5}'); if [ $available_space -lt 10 ]; then curl -X POST -H 'Content-Type: application/json' -d '{"incident": {"type": "incident", "title": "Low disk space alert"}}' https://api.pagerduty.com/incidents; fi; sleep 600; done
while true; do awk '/kernel|panic/ {print $1" "$2" "$3}' /var/log/syslog | while read date time msg; do hour=$(date -d "$date $time" +%Y-%m-%d-%H); echo "$hour" >> /tmp/kernel_tmp.log; done; awk '{cnt[$1]++} END {for (h in cnt) print h, cnt[h]}' /tmp/kernel_tmp.log > /tmp/kernel_alerts.log; rm /tmp/kernel_tmp.log; sleep 600; done &
while true; do cpu_usage=$(top -b -n 1 | awk '/process_name/ {print $9}'); if [ $cpu_usage -gt 80 ]; then curl -s --url 'smtps://smtp.example.com:465' --ssl-reqd --mail-from 'cpu@example.com' --mail-rcpt 'admin@example.com' --upload-file <(echo "CPU usage exceeded 80%"); fi; sleep 1; done
while true; do cpu_usage=$(top -b -n1 | awk 'NR==3 {print $9}'); if [ $cpu_usage -gt 80 ]; then echo 'CPU usage exceeded 80%' | mail -s 'CPU Usage Alert' admin@example.com; systemctl restart myservice; fi; sleep 1; done
while true; do cpu_usage=$(top -b -n2 -p 1 | awk 'NR==3{print $9}'); if [ $cpu_usage -gt 80 ]; then echo 'CPU usage exceeded 80%' | mail -s 'CPU Alert' admin@example.com; fi; sleep 300; done
while true; do date; sleep 300; done
while true; do disk_usage=$(df -h / | awk '//$/ {print $5}'); if [ ${disk_usage//%/} -gt 80 ]; then mail -s 'Disk space alert' user@example.com <<< 'Disk space is $disk_usage'; fi; sleep 5; done
while true; do disk_usage=$(df -h / | awk 'NR==2 {print $5}'); if [ $disk_usage -gt 90 ]; then echo 'Disk usage high' | mail -s 'Alert' admin@example.com; fi; sleep 3600; done
while true; do if ! systemctl is-active --quiet nginx; then echo "$(date '+%F %T') nginx down, restarting" >> /var/log/nginx_monitor.log; systemctl restart nginx; fi; sleep 30; done &
while true; do ps -eo pid,cmd,%cpu --sort=-%cpu | head -10 >> process_log.txt; sleep 60; done
while true; do ps -eo pid,cmd,%mem --sort=-%mem | head -6; sleep 5; done
while true; do usage=$(df -h /var | awk 'NR==2 {print $5}' | tr -d '%'); if (( usage > 80 )); then df -h /var | mail -s \"Disk usage alert on $(hostname)\" admin@example.com; fi; sleep 300; done &
