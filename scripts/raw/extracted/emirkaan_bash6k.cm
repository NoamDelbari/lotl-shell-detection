{ dd if=src.bin of=/mnt/backup/src.bin bs=4M status=none & pid=$!; while kill -0 $pid 2>/dev/null; do copied=$(stat --format=%s /mnt/backup/src.bin 2>/dev/null || echo 0); percent=$(( copied*100/5368709120 )); printf "\rProgress: [%-50s] %3d%%" $(printf "#"{1..$((percent/2))}) $percent; sleep 1; done; wait $pid; echo; }
{ sum=0; count=0; for i in {1..12}; do idle=$(top -bn1 | grep "%Cpu" | awk -F',' '{print $4}' | awk '{print $1}'); sum=$(echo "$sum + $idle" | bc); ((count++)); sleep 5; done; avg=$(echo "scale=2; $sum / $count" | bc); echo "Average idle CPU: $avg%"; }
{ sum=0; count=0; for i in {1..12}; do load=$(awk '{print $1}' /proc/loadavg); sum=$(echo "$sum + $load" | bc); ((count++)); sleep 5; done; avg=$(echo "scale=2; $sum / $count" | bc); echo "{\"average_load\": $avg}" > /tmp/cpu_avg.txt; }
{ total_user=0; total_sys=0; count=0; while [ $count -lt 15 ]; do read -r _ _ _ _ user sys _ < <(top -bn1 | grep '^%Cpu'); total_user=$(echo "$total_user + $user" | bc); total_sys=$(echo "$total_sys + $sys" | bc); ((count++)); sleep 2; done; avg_user=$(echo "scale=2; $total_user / $count" | bc); avg_sys=$(echo "scale=2; $total_sys / $count" | bc); echo "Average User%: $avg_user, System%: $avg_sys"
