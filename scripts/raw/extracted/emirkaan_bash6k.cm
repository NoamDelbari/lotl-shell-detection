archive_latest(){ local dir="$1"; local ext="$2"; local n=${3:-5}; local zipfile="archive_$(date +%s).zip"; find "$dir" -type f -name "*.$ext" -printf "%T@ %p\n" | sort -nr | head -n "$n" | cut -d' ' -f2- | zip -@ "$zipfile" && echo "$zipfile"; }
archive_name="python_backup_$(date +%Y%m%d_%H%M%S).tar.gz"; find ~/projects -type f -name "*.py" -mtime -7 -print0 | tar --null -czvf "$archive_name" -T - && echo "$(date): $archive_name created" >> ~/backup.log
archive_recent(){ local dir="$1"; local ext="$2"; local n=${3:-10}; local ts=$(date +%Y%m%d_%H%M%S); local archive="${dir##*/}_$ts.zip"; find "$dir" -type f -name "*.$ext" -printf '%T@ %p\n' | sort -nr | head -n "$n" | cut -d' ' -f2- | zip -@ "$archive"; echo "Created $archive"; }
