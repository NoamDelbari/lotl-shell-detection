backup() {
backup_db() { mysqldump -u $1 -p$2 $3 | gzip > $3.sql.gz; }; backup_db 'username' 'password' 'database_name'
backup_db() { mysqldump -u $1 -p$2 $3 | gzip > $3_$(date +"%Y-%m-%d_%H-%M-%S").sql.gz; }
backup_db() { mysqldump -u user -p pass db_name | gzip > backup.sql.gz; curl -X PUT --data-binary @backup.sql.gz https://example.com/upload; }
backup_db() { mysqldump -u username -p password database_name | gzip > backup_$(date +"%Y-%m-%d").sql.gz; }; backup_db
backup_db() { timestamp=$(date +'%Y-%m-%d_%H-%M-%S'); mysqldump -u user -p password db > backup_$timestamp.sql; tar -czf backup_$timestamp.tar.gz backup_$timestamp.sql; curl -X POST -H 'Content-Type: application/gzip' --data-binary '@backup_$timestamp.tar.gz' https://example.com/upload; rm backup_$timestamp.sql backup_$timestamp.tar.gz; }; backup_db
backup_dir() { tar -czf backup.tar.gz $1; }; echo '0 0 * * * backup_dir /path/to/dir' >> crontab.txt
backup_dir(){
backup_dir(){ dir="$1"; base=$(basename "$dir"); tar -czf "/backup/${base}_$(date +%F).tar.gz" -C "$(dirname "$dir")" "$base" && echo "$(date '+%Y-%m-%d %H:%M:%S') Backed up $dir" >> /var/log/backup.log; }
backup_dir(){ local dir="$1"; local archive="${dir%/}_$(date +%F).tar.gz"; tar -czf "$archive" -C "$(dirname "$dir")" "$(basename "$dir")" && status=0 || status=$?; echo "$(date +%F\\%T) backup $dir -> $archive status=$status" >> /var/log/backup.log; return $status; }
backup_dir(){ local dir="$1"; local ts=$(date +%Y%m%d%H%M%S); local tarfile="${dir%/}_$ts.tar.gz"; tar -czf "/backup/$tarfile" -C "$(dirname "$dir")" "$(basename "$dir")" && echo "$(date '+%Y-%m-%d %H:%M:%S') Backup created: $tarfile" >> /var/log/backup.log; }
backup_dir(){ local src="$1"; local base=$(basename "$src"); local date=$(date +%Y%m%d); local dest="/backups/${base}_${date}.tar.gz"; tar -czf "$dest" -C "$(dirname "$src")" "$base" && echo "$(date '+%Y-%m-%d %H:%M:%S') BACKUP $src -> $dest" >> /var/log/backup.log || echo "$(date '+%Y-%m-%d %H:%M:%S') BACKUP FAILED for $src" >> /var/log/backup.log; }
backup_dir(){ local src="$1"; local base=$(basename "$src"); local dest="/backup/${base}_$(date +%F).tar.gz"; tar -czf "$dest" -C "$(dirname "$src")" "$base" && echo "$(date +'%Y-%m-%d %H:%M:%S') BACKUP $src -> $dest" >> /var/log/backup.log; }
backup_dir(){ local src="$1"; local base=$(basename "$src"); local dst="/backup/${base}_$(date +%Y%m%d).tar.gz"; if tar -czf "$dst" -C "$(dirname "$src")" "$base"; then echo "$(date +'%F %T') SUCCESS $src -> $dst" >> /var/log/backup.log; else echo "$(date +'%F %T') FAILURE $src" >> /var/log/backup.log; fi }
backup_dir(){ local src="$1"; local base=$(basename "$src"); local ts=$(date +%Y%m%d_%H%M%S); local tarfile="${base}_$ts.tar.gz"; tar -czf "/tmp/$tarfile" -C "$(dirname "$src")" "$base" && if tar -tzf "/tmp/$tarfile" > /dev/null 2>&1; then echo "$(date +%F_%T) SUCCESS: $tarfile created" >> /var/log/backup.log; else echo "$(date +%F_%T) FAILURE: $tarfile corrupted" >> /var/log/backup.log; fi }
backup_dir(){ src="$1"; ts=$(date +%Y%m%d_%H%M%S); dest="/backup/$(basename "$src")_$ts.tar.gz"; if tar -czf "$dest" -C "$(dirname "$src")" "$(basename "$src")"; then echo "$(date +'%F %T') SUCCESS: $src -> $dest" >> /var/log/backup.log && notify-send "Backup Successful" "$src backed up"; else echo "$(date +'%F %T') FAILURE: $src" >> /var/log/backup.log && notify-send "Backup Failed" "$src"; fi }
backup_mysql(){
backup_mysql(){ local ts=$(date +%F_%H-%M-%S); mysqldump --all-databases | pigz | gpg --encrypt --recipient "$1" -o "/backups/mysql_backup_${ts}.sql.gz.gpg"; }
backup_mysql(){ ts=$(date +%Y%m%d_%H%M); dump="/backup/mysql/${ts}.sql.gz"; mkdir -p /backup/mysql; mysqldump --all-databases | gzip > "$dump" && echo "$(date): Backup saved to $dump" >> /var/log/backup_mysql.log; find /backup/mysql -type f -mtime +7 -delete; }
