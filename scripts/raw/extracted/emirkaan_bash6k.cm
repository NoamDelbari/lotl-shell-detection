(crontab -l ; echo "30 9 * * 1 /path/to/script.sh >> /var/log/weekly.log 2>&1") | crontab -
(sleep 60; echo Done > done.txt) &
(while :; do date +%Y-%m-%dT%H:%M:%S, $(docker ps --format "{{.Names}}") | while read name; do cpu=$(docker stats --no-stream --format "{{.CPUPerc}}" "$name" | tr -d '%'); echo "$(date +%Y-%m-%dT%H:%M:%S),$name,$cpu"; done; sleep 10; done) | rotatelogs -l /var/log/docker_cpu_%Y-%m-%d.csv 86400 7
* * * * * echo $(date '+\%Y-\%m-\%d \%H:\%M:\%S') >> /var/log/heartbeat.log
./hello.sh > hello.log 2>&1 &
