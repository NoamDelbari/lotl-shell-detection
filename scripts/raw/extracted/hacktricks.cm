[ -n "$COMMAND" ] && "${COMMAND%%[[:space:]]*}" -v
candidate=$(get_command_line "$pid" | awk '{print $1}')
/usr/sbin/nginx|/usr/sbin/httpd|/usr/sbin/apache2)
"$candidate" -v 2>&1 ;;
