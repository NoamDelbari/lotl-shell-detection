retry() { local tries=0 max=5 delay=1; while (( tries < max )); do "$@" && return 0; (( tries++ )); echo "Attempt $tries failed, retrying in $delay s..."; sleep $delay; (( delay*=2 )); done; return 1; }
retry(){
retry(){ local attempts=0 max=5 delay=1; while ((attempts<max)); do "$@" && return 0; ((attempts++)); echo "Attempt $attempts failed, retrying in $delay seconds..."; sleep $delay; ((delay*=2)); done; return 1; } # Usage: retry curl -sSf https://example.com
retry(){ local cmd="$*"; local delay=1; for i in {1..5}; do echo "Attempt $i: $cmd"; eval $cmd && return 0; echo "Failed, sleeping ${delay}s"; sleep $delay; delay=$((delay*2)); done; return 1; }
retry(){ local cmd="$*"; local delay=1; for i in {1..5}; do eval $cmd && return 0; echo "Attempt $i failed, retrying in $delay sec..."; sleep $delay; delay=$((delay*2)); done; return 1; }
retry(){ local cmd=("$@"); local delay=1; for i in {1..5}; do "${cmd[@]}" && return 0; echo "Attempt $i failed, retrying in $delay s"; sleep $delay; delay=$((delay*2)); done; return 1; }
retry(){ local cmd=\"$*\"; local delay=1; for i in {1..5}; do eval $cmd && return 0; echo \"Attempt $i failed, retrying in $delay seconds...\"; sleep $delay; delay=$((delay*2)); done; return 1; }; retry curl -sSf https://example.com/data.json -o data.json #=> data.json downloaded if successful
retry(){ local max=$1; shift; local attempt=0; local delay=2; while ((attempt<max)); do "$@" && return 0; attempt=$((attempt+1)); echo "Attempt $attempt failed, sleeping $delay sec"; sleep $delay; delay=$((delay*2)); done; return 1; }
retry(){ local n=$1; local delay=$2; shift 2; local i=0; while ((i<n)); do "$@" && return 0; ((i++)); echo "Attempt $i failed, retrying in $delay seconds..."; sleep $delay; done; return 1; }
retry(){ local n=$1; shift; local delay=1; for ((i=1;i<=n;i++)); do "$@" && return 0; echo "Attempt $i failed, retrying in $delay sec..."; sleep $delay; delay=$((delay*2)); done; return 1; }; # usage: retry 5 curl -O http://example.com/file
