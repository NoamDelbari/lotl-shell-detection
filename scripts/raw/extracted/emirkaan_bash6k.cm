prev=0; consec=0; while :; do usage=$(top -bn1 | grep 'Cpu(s)' | awk '{print $2+$4}'); if (( $(echo "$usage > 90" | bc -l) )); then ((consec++)); else consec=0; fi; if ((consec>=3)); then echo "$(date): CPU usage $usage% sustained" >> /var/log/cpu_warn.log; consec=0; fi; sleep 5; done
