safe_move(){ src="$1"; dest_dir="$2"; mkdir -p "$dest_dir"; mv "$src" "$dest_dir" && echo "$(date +'%F %T') Moved $src to $dest_dir" >> ~/move.log; }
safe_rm(){ local trash="$HOME/.trash"; mkdir -p "$trash"; while [ "$#" -gt 0 ]; do src="$1"; dst="$trash${src}"; mkdir -p "$(dirname "$dst")"; mv "$src" "$dst" && echo "$(date +'%F %T') $src -> $dst" >> "$HOME/.trash.log"; shift; done }
